{
  "name": "veyra-launcher",
  "version": "0.7.0",
  "private": true,
  "description": "Veyra Launcher — современный лаунчер Minecraft Java Edition для Windows",
  "main": "main/desktop.js",
  "author": "Veyra Launcher",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "icon": "node scripts/create-icon.js",
    "smoke": "node scripts/smoke.js",
    "check:auth": "node scripts/auth-check.js",
    "check:accounts": "node scripts/auth-ui-check.js",
    "compat": "node scripts/build-compat.js"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "build": {
    "appId": "dev.veyra.launcher",
    "productName": "Veyra Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "artifactName": "Veyra-Launcher-${version}-${arch}.${ext}"
  }
}
