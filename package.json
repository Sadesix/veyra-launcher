{
  "name": "veyra-launcher",
  "version": "0.9.0",
  "private": true,
  "description": "Veyra Launcher — современный лаунчер Minecraft Java Edition для Windows",
  "main": "main/desktop.js",
  "author": "Veyra Launcher",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir && node scripts/build-installer.js",
    "installer": "node scripts/build-installer.js",
    "icon": "node scripts/create-icon.js",
    "smoke": "node scripts/smoke.js",
    "check:auth": "node scripts/auth-check.js",
    "check:auth-ui": "node scripts/auth-ui-check.js",
    "check:skin3d": "node scripts/skin3d-check.js",
    "check:veyra": "node scripts/veyra-account-check.js",
    "compat": "node scripts/build-compat.js",
    "check:updates": "node scripts/update-check.js",
    "check:installer": "node scripts/installer-check.js",
    "release": "npm run dist && node scripts/publish.js && node scripts/github-release.js",
    "release:upload": "node scripts/publish.js",
    "release:github": "node scripts/github-release.js"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "build": {
    "appId": "dev.veyra.launcher",
    "productName": "Veyra Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!assets/brand/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "dir"
    },
    "artifactName": "Veyra-Launcher-${version}-${arch}.${ext}"
  },
  "license": "MIT",
  "homepage": "https://veyra-launcher.com"
}
