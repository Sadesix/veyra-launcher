<!-- Окно установщика Veyra. Вставки BUTTON и ICON в двойных фигурных скобках подставляет scripts/build-installer.js:
     кнопки собираются из пиксельных рамок, иконки — из тех же сеток 12×12, что в лаунчере. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="880" Height="560" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="#201b22"
      TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#d29a8a" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="Foreground" Value="#f0e1d3" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#17131a" Direction="315" ShadowDepth="4" BlurRadius="0" Opacity="1" /></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="Foreground" Value="#cdbfb4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="#a3968f" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#a3968f" />
    </Style>
    <Style x:Key="OptionTitle" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#f0e1d3" />
    </Style>
    <Style x:Key="OptionNote" TargetType="TextBlock" BasedOn="{StaticResource Small}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    {{BUTTON:Primary|#d29a8a|#ecccc1|#b17868|#17131a}}
    {{BUTTON:Create|#8eae91|#b4cdb6|#729275|#17131a}}
    {{BUTTON:Quiet|#2f2932|#4a404d|#17131a|#f0e1d3}}
    {{BUTTON:Danger|#9e4b44|#c06a61|#6e302b|#f0e1d3}}

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#a3968f" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Width="30" Height="30" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#2f2932" /><Setter Property="Foreground" Value="#f0e1d3" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#a7acc9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent" Padding="0,4" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline" /><Setter Property="Foreground" Value="#f0e1d3" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="21" Height="21" Margin="0,0,13,0" VerticalAlignment="Top" Background="#1d181f" BorderBrush="#17131a" BorderThickness="3">
                <Path x:Name="Mark" Width="11" Height="11" Stretch="Fill" Data="{{ICON:check}}" Fill="#17131a" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#8eae91" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#d29a8a" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#f0e1d3" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#1d181f" />
      <Setter Property="Foreground" Value="#f0e1d3" />
      <Setter Property="CaretBrush" Value="#f0e1d3" />
      <Setter Property="SelectionBrush" Value="#a7acc9" />
      <Setter Property="BorderBrush" Value="#17131a" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Height" Value="45" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border BorderBrush="#131016" BorderThickness="3,3,0,0">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#d29a8a" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DrawingBrush x:Key="XpFill" TileMode="Tile" Stretch="None" Viewport="0,0,21,12" ViewportUnits="Absolute" Viewbox="0,0,21,12" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#8eae91"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,12" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#729275"><GeometryDrawing.Geometry><RectangleGeometry Rect="18,0,3,12" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#b4cdb6"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,3" /></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="Xp" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="#17131a" Padding="3">
              <Grid x:Name="PART_Track" Background="#241e27">
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{StaticResource XpFill}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#3317131a" />
      <Setter Property="BorderBrush" Value="#2f2932" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="Padding" Value="15,12" />
    </Style>
    <Style x:Key="Note" TargetType="Border">
      <Setter Property="Background" Value="#268eae91" />
      <Setter Property="BorderBrush" Value="#8eae91" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="330" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>

  <!-- Слева — картина мира и логотип -->
  <Grid x:Name="Art" ClipToBounds="True" Background="#17131a">
    <Image x:Name="Scene" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#40201b22" Offset="0" />
          <GradientStop Color="#A0201b22" Offset="0.5" />
          <GradientStop Color="#F2201b22" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Canvas x:Name="Motes" IsHitTestVisible="False" />
    <StackPanel VerticalAlignment="Center" Margin="28,0,28,30">
      <Image x:Name="Logo" Width="210" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><TranslateTransform x:Name="LogoFloat" /></Image.RenderTransform>
      </Image>
      <TextBlock Style="{StaticResource Lead}" FontSize="14" TextAlignment="Center" Margin="0,24,0,0" Foreground="#f0e1d3">Лаунчер Minecraft,<LineBreak />собранный из блоков</TextBlock>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="26,0,0,26">
      <Border Background="#d29a8a" BorderBrush="#17131a" BorderThickness="3" Padding="8,3,8,5">
        <TextBlock x:Name="VersionBadge" Style="{StaticResource Mono}" FontSize="12" Foreground="#17131a" Text="0.0.0" />
      </Border>
      <Button x:Name="SiteLink" Style="{StaticResource Link}" Content="veyra-launcher.com" Margin="13,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Rectangle Width="3" HorizontalAlignment="Right" Fill="#17131a" />
  </Grid>

  <!-- Справа — шаги установки -->
  <Grid Grid.Column="1" x:Name="Side">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <TextBlock x:Name="TitleText" Style="{StaticResource Label}" FontSize="12" Margin="44,0,0,0" VerticalAlignment="Center" Text="Установка Veyra Launcher" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,12,0">
        <Button x:Name="MinimizeButton" Style="{StaticResource Chrome}" ToolTip="Свернуть">
          <Rectangle Width="12" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,9,0,0" />
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource Chrome}" ToolTip="Закрыть" Margin="4,0,0,0">
          <Path Width="12" Height="12" Stretch="Fill" Data="{{ICON:close}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="44,4,44,0">
      <Grid.RenderTransform><TranslateTransform x:Name="PageShift" /></Grid.RenderTransform>

      <!-- Начало установки -->
      <StackPanel x:Name="Welcome">
        <TextBlock x:Name="WelcomeEyebrow" Style="{StaticResource Eyebrow}" Text="УСТАНОВКА" />
        <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" Text="Veyra" />
        <TextBlock x:Name="WelcomeLead" Style="{StaticResource Lead}" Text="Лаунчер Minecraft Java Edition в стиле самой игры. Установка займёт меньше минуты и не потребует прав администратора." />
        <Border x:Name="MigrationNote" Style="{StaticResource Note}" Margin="0,16,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Small}" Foreground="#d8e6d9" Text="Veyra теперь устанавливается как обычная программа: так она открывается за доли секунды и обновляется сама. Сборки, миры и настройки останутся на месте." />
        </Border>
        <TextBlock Style="{StaticResource Label}" Text="ПАПКА УСТАНОВКИ" Margin="0,22,0,9" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="RootBox" Style="{StaticResource Field}" />
          <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource Quiet}" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stretch="Fill" Data="{{ICON:folder}}" Fill="#f0e1d3" Margin="0,0,9,0" VerticalAlignment="Center" />
              <TextBlock Text="Изменить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock x:Name="SpaceText" Style="{StaticResource Small}" Margin="0,8,0,0" />
        <StackPanel Margin="0,20,0,0">
          <CheckBox x:Name="DesktopBox" Style="{StaticResource Check}" IsChecked="True">
            <TextBlock Style="{StaticResource OptionTitle}" Text="Ярлык на рабочем столе" />
          </CheckBox>
          <CheckBox x:Name="StartBox" Style="{StaticResource Check}" IsChecked="True" Margin="0,13,0,0">
            <TextBlock Style="{StaticResource OptionTitle}" Text="Ярлык в меню «Пуск»" />
          </CheckBox>
          <CheckBox x:Name="LaunchBox" Style="{StaticResource Check}" IsChecked="True" Margin="0,13,0,0">
            <TextBlock Style="{StaticResource OptionTitle}" Text="Запустить Veyra после установки" />
          </CheckBox>
        </StackPanel>
      </StackPanel>

      <!-- Лаунчер уже стоит -->
      <StackPanel x:Name="Existing" Visibility="Collapsed">
        <TextBlock x:Name="ExistingEyebrow" Style="{StaticResource Eyebrow}" Text="УЖЕ УСТАНОВЛЕНА" />
        <TextBlock x:Name="ExistingTitle" Style="{StaticResource H1}" Text="Veyra на месте" />
        <TextBlock x:Name="ExistingLead" Style="{StaticResource Lead}" />
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="ПАПКА" Margin="0,0,0,6" />
            <TextBlock x:Name="ExistingPath" Style="{StaticResource Small}" Foreground="#f0e1d3" />
          </StackPanel>
        </Border>
        <CheckBox x:Name="ExistingLaunch" Style="{StaticResource Check}" IsChecked="True" Margin="0,20,0,0">
          <TextBlock Style="{StaticResource OptionTitle}" Text="Запустить Veyra после установки" />
        </CheckBox>
        <Button x:Name="ExistingRemove" Style="{StaticResource Link}" Content="Удалить Veyra с компьютера" HorizontalAlignment="Left" Margin="0,18,0,0" />
      </StackPanel>

      <!-- Процесс -->
      <StackPanel x:Name="Working" Visibility="Collapsed">
        <TextBlock x:Name="WorkingEyebrow" Style="{StaticResource Eyebrow}" Text="УСТАНОВКА" />
        <TextBlock x:Name="WorkingTitle" Style="{StaticResource H1}" Text="Устанавливаем Veyra" />
        <TextBlock x:Name="WorkingLead" Style="{StaticResource Lead}" Text="Это займёт меньше минуты. Сборки, миры и настройки не затрагиваются." />
        <StackPanel x:Name="StepList" Margin="0,24,0,0" />
        <ProgressBar x:Name="Bar" Style="{StaticResource Xp}" Height="18" Minimum="0" Maximum="1000" Margin="0,24,0,0" />
        <Grid Margin="0,10,0,0">
          <TextBlock x:Name="BarText" Style="{StaticResource Small}" />
          <TextBlock x:Name="BarPercent" Style="{StaticResource Mono}" FontSize="12" Foreground="#f0e1d3" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>

      <!-- Готово -->
      <StackPanel x:Name="Done" Visibility="Collapsed">
        <Border x:Name="DoneBadge" Width="66" Height="66" HorizontalAlignment="Left" Background="#8eae91" BorderBrush="#17131a" BorderThickness="3">
          <Border BorderBrush="#b4cdb6" BorderThickness="3,3,0,0">
            <Path Width="30" Height="30" Stretch="Fill" Data="{{ICON:check}}" Fill="#17131a" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border.RenderTransform><ScaleTransform x:Name="DoneScale" CenterX="33" CenterY="33" /></Border.RenderTransform>
        </Border>
        <TextBlock x:Name="DoneEyebrow" Style="{StaticResource Eyebrow}" Text="ГОТОВО" Margin="0,26,0,12" />
        <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Text="Veyra установлена" />
        <TextBlock x:Name="DoneLead" Style="{StaticResource Lead}" />
        <Border x:Name="DoneTips" Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Small}" Text="Сборки и миры хранятся в «Документы\Veyra Launcher»." />
            <TextBlock Style="{StaticResource Small}" Text="Новые версии лаунчер скачивает и ставит сам — режим выбирается в настройках." Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource Small}" Text="Удалить Veyra можно в «Параметры → Приложения»." Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Ошибка -->
      <StackPanel x:Name="Failed" Visibility="Collapsed">
        <Border Width="66" Height="66" HorizontalAlignment="Left" Background="#9e4b44" BorderBrush="#17131a" BorderThickness="3">
          <Path Width="24" Height="24" Stretch="Fill" Data="{{ICON:close}}" Fill="#f0e1d3" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Style="{StaticResource Eyebrow}" Text="ЧТО-ТО ПОШЛО НЕ ТАК" Margin="0,26,0,12" Foreground="#e07a6e" />
        <TextBlock x:Name="FailedTitle" Style="{StaticResource H1}" Text="Установка не удалась" />
        <TextBlock x:Name="FailedLead" Style="{StaticResource Lead}" />
        <TextBlock Style="{StaticResource Small}" Text="Уже установленная версия, сборки и настройки не пострадали." Margin="0,14,0,0" />
        <Button x:Name="FailedLog" Style="{StaticResource Link}" Content="Открыть журнал установки" HorizontalAlignment="Left" Margin="0,16,0,0" />
      </StackPanel>

      <!-- Удаление -->
      <StackPanel x:Name="Remove" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Eyebrow}" Text="УДАЛЕНИЕ" />
        <TextBlock x:Name="RemoveTitle" Style="{StaticResource H1}" Text="Удалить Veyra?" />
        <TextBlock x:Name="RemoveLead" Style="{StaticResource Lead}" />
        <Border x:Name="RunningNote" Style="{StaticResource Note}" BorderBrush="#d29a8a" Background="#26d29a8a" Margin="0,16,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Small}" Foreground="#f0e1d3" Text="Veyra сейчас открыта — установщик закроет её и сохранит настройки." />
        </Border>
        <CheckBox x:Name="RemoveSettings" Style="{StaticResource Check}" Margin="0,22,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource OptionTitle}" Text="Удалить и настройки лаунчера" />
            <TextBlock Style="{StaticResource OptionNote}" Text="Вход, параметры, скачанная Java и список версий." />
          </StackPanel>
        </CheckBox>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Small}" Text="Сборки, миры и скриншоты в «Документы\Veyra Launcher» останутся. Если они больше не нужны, удалите папку вручную." />
            <Button x:Name="RemoveOpenBuilds" Style="{StaticResource Link}" Content="Открыть папку сборок" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="44,0,44,32">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterNote" Style="{StaticResource Small}" FontSize="12" LineHeight="17" VerticalAlignment="Center" Margin="0,0,18,0"
                 Text="Veyra — независимый лаунчер, не связан с Mojang и Microsoft." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SecondaryButton" Style="{StaticResource Quiet}" IsCancel="True">
          <TextBlock x:Name="SecondaryLabel" Text="Отмена" />
        </Button>
        <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Margin="15,0,0,0" IsDefault="True">
          <StackPanel Orientation="Horizontal">
            <Path x:Name="PrimaryIcon" Width="12" Height="12" Stretch="Fill" Data="{{ICON:download}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="PrimaryLabel" Text="Установить" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Grid>
